# Base de données (Neon Postgres — driver neon-serverless, jamais neon-http)
#
# DATABASE_URL : rôle applicatif restreint (CREATE ROLE ... NOBYPASSRLS),
# utilisé par l'application ET les tests — jamais le rôle "owner" par défaut
# de Neon, qui a BYPASSRLS et rendrait toutes les politiques RLS inactives
# sans erreur ni avertissement (confirmé par test réel, voir CLAUDE.md).
DATABASE_URL="postgresql://app_vertexone:password@ep-xxx-pooler.neon.tech/vertexone?sslmode=require"

# DATABASE_URL_MIGRATIONS : rôle owner (droits DDL), utilisé uniquement par
# drizzle-kit pour generate/migrate — jamais par le code applicatif.
DATABASE_URL_MIGRATIONS="postgresql://neondb_owner:password@ep-xxx-pooler.neon.tech/vertexone?sslmode=require"

# DATABASE_URL_WORKER : rôle owner, endpoint DIRECT (sans "-pooler") — utilisé
# uniquement par graphile-worker (src/worker/run.ts). Le pooler Neon casse
# LISTEN/NOTIFY, sur lequel graphile-worker s'appuie pour sa connexion
# persistante — voir CLAUDE.md, section file d'attente.
DATABASE_URL_WORKER="postgresql://neondb_owner:password@ep-xxx.neon.tech/vertexone?sslmode=require"

# Console interne plateforme (2026-09-14) — rôle Postgres plateforme_lecture
# (BYPASSRLS, lecture seule uniquement), SQL de création exact dans
# docs/mise-en-production-checklist.md. PLATEFORME_ADMINS : liste d'emails
# (séparés par des virgules) de comptes tenant existants reconnus comme
# staff Vertex One — aucune nouvelle inscription nécessaire.
DATABASE_URL_PLATEFORME="postgresql://plateforme_lecture:password@ep-xxx-pooler.neon.tech/vertexone?sslmode=require"
PLATEFORME_ADMINS="fondateur@vertexone.cm"

# Better-Auth
BETTER_AUTH_SECRET="" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Boîte mail hébergée (Migadu)
MIGADU_API_KEY=""

# Email transactionnel
RESEND_API_KEY=""

# Formulaire de contact du site vitrine (src/app/(marketing)/contact,
# src/lib/actions/message-contact.ts) — email qui reçoit les messages, via
# envoyerEmail() (src/lib/email/client.ts).
# Mêmes limites que le reste des emails tant qu'aucun domaine Resend n'est
# vérifié (voir CLAUDE.md, section Resend) : l'envoi ne part réellement que
# si cette adresse est celle du propriétaire du compte Resend.
CONTACT_DESTINATAIRE=""

# Kyria — assistante IA du site vitrine (src/lib/kyria/, src/app/api/kyria)
# Clé personnelle sur console.anthropic.com. Tant qu'elle n'est pas
# configurée, Kyria répond proprement qu'elle n'est pas encore disponible
# (jamais un crash) — voir src/lib/kyria/client.ts.
ANTHROPIC_API_KEY=""

# Mobile Money (CinetPay, package cinetpay-js) — dashboard.cinetpay.com, section "Intégrations"/"API"
CINETPAY_APIKEY=""
CINETPAY_APIPASSWORD=""

# Anti-spam One Form (Cloudflare Turnstile, gratuit) — dash.cloudflare.com
# → Turnstile → ajouter un site. TURNSTILE_SECRET_KEY reste côté serveur ;
# NEXT_PUBLIC_TURNSTILE_SITE_KEY est envoyée au navigateur (nom imposé par
# Next.js pour toute variable exposée côté client). Tant que ces deux clés
# ne sont pas configurées, le widget ne s'affiche pas et la vérification est
# ignorée — voir src/lib/turnstile/client.ts.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# One Vault — chiffrement des secrets stockés (AES-256-GCM). Clé de 32
# octets encodée en base64, générée avec `openssl rand -base64 32` — jamais
# réutiliser la valeur d'exemple. Contrairement au reste des intégrations
# de ce fichier, l'absence de cette clé ne dégrade pas silencieusement :
# toute création/modification de secret est refusée plutôt que stockée en
# clair — voir src/lib/vault/crypto.ts.
VAULT_ENCRYPTION_KEY=""

# WhatsApp Business (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Stockage (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Messagerie interne (chat-as-a-service, ex. Stream Chat) — voir
# src/lib/chat/client.ts. Tant que non configurée, le code réel (préfixage
# par entrepriseId, création de canal au pont Palier 2→3) s'exécute sans
# appeler le prestataire (avertissement en log, pas d'échec silencieux).
STREAM_CHAT_API_KEY=""
